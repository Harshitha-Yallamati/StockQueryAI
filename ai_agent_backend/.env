# SQLite file path for inventory and order data.
STOCKQUERY_DB_PATH=./agent_inventory.db

# Persistent Chroma directory for knowledge-base embeddings.
STOCKQUERY_CHROMA_PATH=./chroma_db

# OpenAI-compatible base URL used by Gemini's OpenAI-compatible API.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# API key sent to the OpenAI-compatible client.
OPENAI_API_KEY=AIzaSyBpYicGgJPFotxeTvz8ON8mFjqMS2RnEwk

# Chat model used by the inventory agent.
STOCKQUERY_LLM_MODEL=gemini-2.5-flash

# Default threshold for low-stock alerts and tool routing.
STOCKQUERY_LOW_STOCK_THRESHOLD=10

# LLM response timeout in seconds (qwen2.5:1.5b on CPU needs ~15-30 s).
STOCKQUERY_LLM_TIMEOUT_SECONDS=60

# Number of chat turns retained per session.
STOCKQUERY_SESSION_HISTORY_LIMIT=12

# Comma-separated frontend origins allowed by CORS.
STOCKQUERY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081
