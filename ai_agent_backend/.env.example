# SQLite file path for inventory and order data.
# For Render deployment, use: /data/agent_inventory.db
STOCKQUERY_DB_PATH=./agent_inventory.db

# Persistent Chroma directory for knowledge-base embeddings.
# For Render deployment, use: /data/chroma_db
STOCKQUERY_CHROMA_PATH=./chroma_db

# OpenAI-compatible base URL.
# Local development: http://localhost:11434/v1 (Ollama)
# Production: https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini)
OPENAI_BASE_URL=http://localhost:11434/v1

# API key sent to the OpenAI-compatible client.
# For Gemini: Use your Google AI API key
# For Ollama: ollama
OPENAI_API_KEY=ollama

# Chat model used by the inventory agent.
# Local: qwen2.5:1.5b
# Production: gemini-1.5-flash
STOCKQUERY_LLM_MODEL=qwen2.5:1.5b

# Maximum time to wait for the local LLM before falling back to a deterministic verified response.
STOCKQUERY_LLM_TIMEOUT_SECONDS=12

# Default threshold for low-stock alerts and tool routing.
STOCKQUERY_LOW_STOCK_THRESHOLD=10

# Number of chat turns retained per session.
# Increased for better conversation context
STOCKQUERY_SESSION_HISTORY_LIMIT=20

# Comma-separated frontend origins allowed by CORS.
# Include your Vercel frontend URL and local development URLs
STOCKQUERY_CORS_ORIGINS=https://stockqueryai.vercel.app,https://stockqueryai-1-igzs.onrender.com,http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081
